def cv_plot_histories(folds):
    """Training loss per epoch for every fold (forward and inverse). No held-out curve: the held-out fold is
    deliberately not evaluated during training."""
    import matplotlib.pyplot as plt
    hist = {}
    for f in folds:
        pth = cv_fold_path(int(f) - 1, "history.json")
        if os.path.isfile(pth):
            with open(pth) as fh:
                hist[int(f)] = json.load(fh)
    if not hist:
        return None
    fig, axes = plt.subplots(1, 2, figsize=(11, 4))
    for ax, key, title in ((axes[0], "forward_train_loss", "Forward DeepONet"), (axes[1], "inverse_train_loss", "Inverse CNN")):
        for f, h in sorted(hist.items()):
            ax.plot(range(1, len(h[key]) + 1), h[key], label=f"fold {f}")
        ax.set_yscale("log"); ax.set_xlabel("Epoch"); ax.set_ylabel("Training loss (total)")
        ax.set_title(title); ax.legend()
    fig.tight_layout()
    out = os.path.join(CV_DIR, "kfold_training_loss_per_fold.png")
    fig.savefig(out, dpi=300)
    plt.close(fig)
    return out


# ---------------------- TORCH PARTS (copied from the notebook recipe) ----------------------
def cv_daem_alpha(branch_phys, trunk_phys):
    """Exact discrete DAEM on the trunk grid; identical to the alpha_daem computation in daem_residual_loss."""
    t = trunk_phys[:, :, 0]
    beta = trunk_phys[:, :, 1]
    logA = branch_phys[:, [0, 3, 6]]
    E = branch_phys[:, [1, 4, 7]] * 1000.0
    c = branch_phys[:, [2, 5, 8]]
    A = (10.0 ** logA).unsqueeze(1)
    E = E.unsqueeze(1)
    c = c.unsqueeze(1)
    T = 273.15 + beta.unsqueeze(-1) * t.unsqueeze(-1)
    k = A * torch.exp(-E / (CV_R_GAS * T))
    dt = t[:, 1:] - t[:, :-1]
    integ = torch.cumsum(0.5 * (k[:, 1:, :] + k[:, :-1, :]) * dt.unsqueeze(-1), dim=1)
    integ = torch.cat([torch.zeros_like(integ[:, :1, :]), integ], dim=1)
    return torch.sum(c * (1.0 - torch.exp(-integ)), dim=-1)


def cv_daem_residual_loss(alpha_pred, branch_norm, trunk_norm, st):
    """Notebook daem_residual_loss, but de-normalising with THIS fold's statistics (st), not notebook globals."""
    alpha_pred = alpha_pred.squeeze(-1)
    branch_phys = branch_norm * st["bs"] + st["bm"]
    trunk_phys = trunk_norm * st["ts"] + st["tm"]
    alpha_daem = cv_daem_alpha(branch_phys, trunk_phys)
    t = trunk_phys[:, :, 0]
    dt = t[:, 1:] - t[:, :-1]
    d_pred = (alpha_pred[:, 1:] - alpha_pred[:, :-1]) / (dt + 1e-8)
    d_daem = (alpha_daem[:, 1:] - alpha_daem[:, :-1]) / (dt + 1e-8)
    return torch.mean((d_pred - d_daem) ** 2)


def cv_set_seed(seed):
    import random
    random.seed(seed); np.random.seed(seed); torch.manual_seed(seed); torch.cuda.manual_seed_all(seed)


def cv_train_forward(bn, tn, al, st, seed):
    """Physics-informed forward DeepONet, same recipe as notebook CELL 6 (no best-epoch selection)."""
    cv_set_seed(seed)
    model = ForwardDeepONet().to(device)
    mse = nn.MSELoss()
    opt = torch.optim.AdamW(model.parameters(), lr=1e-3, weight_decay=1e-5)
    sched = torch.optim.lr_scheduler.ReduceLROnPlateau(opt, mode="min", factor=0.5, patience=10)
    n = bn.shape[0]
    n_batches = int(np.ceil(n / CV_FWD_BATCH))
    last, history = float("nan"), []
    for epoch in range(CV_FORWARD_EPOCHS):
        model.train()
        perm = torch.randperm(n, device=bn.device)
        running = torch.zeros((), device=device)
        for i in range(0, n, CV_FWD_BATCH):
            idx = perm[i:i + CV_FWD_BATCH]
            b, t = bn[idx].to(device), tn[idx].to(device)
            a = al[idx].to(device).unsqueeze(-1)
            opt.zero_grad(set_to_none=True)
            pred = model(b, t)
            loss = (mse(pred, a) + CV_LAMBDA_PHYS * cv_daem_residual_loss(pred, b, t, st)
                    + CV_LAMBDA_IC * mse(pred[:, 0, :], torch.zeros_like(pred[:, 0, :])))
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            opt.step()
            running = running + loss.detach()
        last = float(running) / n_batches
        history.append(last)
        sched.step(last)
        print(f"    forward epoch {epoch + 1}/{CV_FORWARD_EPOCHS} train loss {last:.4e}")
    model.eval()
    for p in model.parameters():
        p.requires_grad = False
    return model, history


class CvInverseNet(InverseNet):
    """Your notebook InverseNet, unchanged except for one line type: under AMP the heads return float16 while
    `branch_phys` is float32, and EAGER PyTorch refuses `branch_phys[:, idx] = half_tensor`
    ("Index put requires the source and destination dtypes match"). Your original training ran through
    torch.compile, which silently casts the values to the destination dtype; this does the same cast explicitly,
    so the maths is identical and the state_dict keys are identical (weights load into InverseNet)."""
    def forward(self, trunk_norm, alpha):
        x = torch.cat([trunk_norm, alpha.unsqueeze(-1)], dim=-1).permute(0, 2, 1)
        x = self.stem(x)
        x = self.res_blocks(x)
        x = self.attn(x)
        z = torch.cat([self.avg_pool(x).flatten(1), self.max_pool(x).flatten(1)], dim=1)
        z = self.shared_fc(z)
        logA = self.logA_min + (self.logA_max - self.logA_min) * torch.sigmoid(self.head_logA(z))
        E = self.E_min + (self.E_max - self.E_min) * torch.sigmoid(self.head_E(z))
        c = torch.softmax(self.head_c(z), dim=1)
        branch_phys = torch.zeros(alpha.shape[0], 9, dtype=alpha.dtype, device=alpha.device)
        branch_phys[:, [0, 3, 6]] = logA.to(branch_phys.dtype)
        branch_phys[:, [1, 4, 7]] = E.to(branch_phys.dtype)
        branch_phys[:, [2, 5, 8]] = c.to(branch_phys.dtype)
        branch_norm = (branch_phys - self.branch_mean) / self.branch_std
        return branch_norm, branch_phys


def cv_train_inverse(fwd, bn, tn, al, bid, basis, bm, bs, seed):
    """Inverse CNN, same recipe as notebook CELL 6B with the fold's frozen forward model (no best-epoch selection)."""
    cv_set_seed(seed)
    inv = CvInverseNet(branch_mean=bm, branch_std=bs, n_time=al.shape[1]).to(device)
    if CV_USE_COMPILE:
        try:
            inv = torch.compile(inv)
        except Exception as exc:
            print("    torch.compile skipped:", exc)
    use_amp = device.type == "cuda"
    opt = torch.optim.AdamW(inv.parameters(), lr=1e-3, weight_decay=1e-5)
    sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=CV_INVERSE_EPOCHS, eta_min=1e-5)
    scaler = torch.amp.GradScaler("cuda", enabled=use_amp)
    n = bn.shape[0]
    n_batches = int(np.ceil(n / CV_INV_BATCH))
    last, history = float("nan"), []
    for epoch in range(1, CV_INVERSE_EPOCHS + 1):
        lam_recon, lam_branch, lam_mono, lam_c = curriculum_weights(epoch, CV_INVERSE_EPOCHS)
        inv.train()
        perm = torch.randperm(n, device=bn.device)
        running = torch.zeros((), device=device)
        for i in range(0, n, CV_INV_BATCH):
            idx = perm[i:i + CV_INV_BATCH]
            trunk_norm, alpha_true = tn[idx].to(device), al[idx].to(device)
            branch_true_norm = bn[idx].to(device)
            trunk_basis = basis[bid[idx].to(device)]
            opt.zero_grad(set_to_none=True)
            with torch.amp.autocast("cuda", enabled=use_amp):
                branch_pred_norm, branch_pred_phys = inv(trunk_norm, alpha_true)
                alpha_recon = torch.sigmoid(
                    torch.einsum("bi,bni->bn", fwd.branch(branch_pred_norm), trunk_basis) + fwd.bias)
                loss, _, _, _, _ = total_inverse_loss(
                    branch_pred_norm, branch_pred_phys, branch_true_norm, alpha_recon, alpha_true,
                    lambda_recon=lam_recon, lambda_branch=lam_branch, lambda_mono=lam_mono, lambda_c=lam_c)
            scaler.scale(loss).backward()
            scaler.unscale_(opt)
            torch.nn.utils.clip_grad_norm_(inv.parameters(), max_norm=1.0)
            scaler.step(opt)
            scaler.update()
            running = running + loss.detach()
        sched.step()
        last = float(running) / n_batches
        history.append(last)
        if epoch == 1 or epoch % 10 == 0 or epoch == CV_INVERSE_EPOCHS:
            print(f"    inverse epoch {epoch}/{CV_INVERSE_EPOCHS} train loss {last:.4e}")
    inv.eval()
    return inv, history


def cv_unique_basis(fwd, tn_np, first):
    with torch.no_grad():
        rep = torch.as_tensor(tn_np[first], dtype=torch.float32, device=device)
        nb, nt, _ = rep.shape
        return fwd.trunk(rep.reshape(-1, 2)).reshape(nb, nt, -1)


def cv_run_fold(k):
    t_start = time.time()
    fold_dir = os.path.join(CV_DIR, f"fold_{k + 1}")
    os.makedirs(fold_dir, exist_ok=True)
    te_idx = np.where(cv_fold_of_curve == k)[0]
    tr_idx = np.where(cv_fold_of_curve != k)[0]
    g_tr, g_te = np.unique(cv_group_ids[tr_idx]), np.unique(cv_group_ids[te_idx])
    if len(np.intersect1d(g_tr, g_te)) != 0:
        raise AssertionError("Parameter-set leakage between train and held-out folds.")
    print(f"\n=== Fold {k + 1}/{CV_N_FOLDS}: train {len(g_tr)} sets / {len(tr_idx)} curves | "
          f"held-out {len(g_te)} sets / {len(te_idx)} curves ===")

    b_tr, t_tr, a_tr = cv_branch[tr_idx], cv_trunk[tr_idx], cv_alpha[tr_idx]
    b_te, t_te, a_te = cv_branch[te_idx], cv_trunk[te_idx], cv_alpha[te_idx]
    # normalisation statistics from this fold's TRAINING curves only (same formulas as notebook CELL 4)
    bm, bs = b_tr.mean(axis=0), b_tr.std(axis=0) + 1e-8
    tm, ts = t_tr.mean(axis=(0, 1)), t_tr.std(axis=(0, 1)) + 1e-8
    bn_tr, bn_te = ((b_tr - bm) / bs).astype(np.float32), ((b_te - bm) / bs).astype(np.float32)
    tn_tr, tn_te = ((t_tr - tm) / ts).astype(np.float32), ((t_te - tm) / ts).astype(np.float32)
    st = {n: torch.as_tensor(v, dtype=torch.float32, device=device) for n, v in
          (("bm", bm), ("bs", bs), ("tm", tm), ("ts", ts))}

    dd = CV_DATA_DEVICE
    to_dd = lambda x: torch.as_tensor(x, dtype=torch.float32, device=dd)
    T_bn_tr, T_tn_tr, T_al_tr = to_dd(bn_tr), to_dd(tn_tr), to_dd(a_tr)

    print("  forward DeepONet")
    fwd, fwd_hist = cv_train_forward(T_bn_tr, T_tn_tr, T_al_tr, st, seed=CV_SEED + 1000 + k)

    # held-out forward accuracy (grouped, so the held-out parameter sets were never seen)
    acc_fwd = _CvAcc()
    T_bn_te, T_tn_te, T_al_te = to_dd(bn_te), to_dd(tn_te), to_dd(a_te)
    with torch.no_grad():
        for i in range(0, len(te_idx), CV_FWD_BATCH):
            sl = slice(i, i + CV_FWD_BATCH)
            pred = fwd(T_bn_te[sl].to(device), T_tn_te[sl].to(device)).squeeze(-1)
            acc_fwd.add(pred, T_al_te[sl].to(device))

    print("  inverse CNN (uses this fold's frozen forward model)")
    first_tr, bid_tr_np = cv_beta_index(tn_tr)
    first_te, bid_te_np = cv_beta_index(tn_te)
    basis_tr, basis_te = cv_unique_basis(fwd, tn_tr, first_tr), cv_unique_basis(fwd, tn_te, first_te)
    inv, inv_hist = cv_train_inverse(fwd, T_bn_tr, T_tn_tr, T_al_tr,
                                     torch.as_tensor(bid_tr_np, dtype=torch.long, device=dd),
                                     basis_tr, bm, bs, seed=CV_SEED + 2000 + k)

    # held-out inverse accuracy: final epoch, all held-out curves
    bid_te = torch.as_tensor(bid_te_np, dtype=torch.long, device=dd)
    T_t_te_phys = to_dd(t_te)
    acc_rf, acc_re, preds = _CvAcc(), _CvAcc(), []
    with torch.no_grad():
        for i in range(0, len(te_idx), CV_INV_BATCH):
            sl = slice(i, i + CV_INV_BATCH)
            trunk_norm, alpha_true = T_tn_te[sl].to(device), T_al_te[sl].to(device)
            bp_norm, bp_phys = inv(trunk_norm, alpha_true)
            recon = torch.sigmoid(torch.einsum("bi,bni->bn", fwd.branch(bp_norm),
                                               basis_te[bid_te[sl].to(device)]) + fwd.bias)
            exact = cv_daem_alpha(bp_phys.float(), T_t_te_phys[sl].to(device))
            acc_rf.add(recon, alpha_true)
            acc_re.add(exact, alpha_true)
            preds.append(bp_phys.detach().cpu().numpy())
    pm = cv_param_metrics(b_te, np.concatenate(preds, axis=0), cv_group_ids[te_idx])

    row = {"fold": k + 1, "n_train_sets": int(len(g_tr)), "n_test_sets": int(len(g_te)),
           "n_train_curves": int(len(tr_idx)), "n_test_curves": int(len(te_idx)),
           "fwd_alpha_RMSE": acc_fwd.rmse(), "fwd_alpha_MAE": acc_fwd.mae(), "fwd_alpha_R2": acc_fwd.r2(),
           "recon_fwd_RMSE": acc_rf.rmse(), "recon_fwd_MAE": acc_rf.mae(), "recon_fwd_R2": acc_rf.r2(),
           "recon_exact_RMSE": acc_re.rmse(), "recon_exact_MAE": acc_re.mae(), "recon_exact_R2": acc_re.r2(),
           **{f"inv_{key}": v for key, v in pm.items()},
           "final_train_loss_forward": fwd_hist[-1], "final_train_loss_inverse": inv_hist[-1],
           "minutes": (time.time() - t_start) / 60.0}
    core = inv._orig_mod if hasattr(inv, "_orig_mod") else inv
    torch.save({"forward_state_dict": fwd.state_dict(), "inverse_state_dict": core.state_dict(),
                "branch_mean": bm, "branch_std": bs, "trunk_mean": tm, "trunk_std": ts,
                "held_out_group_ids": g_te, "fold": k + 1}, cv_fold_path(k, "models.pt"))
    with open(cv_fold_path(k, "history.json"), "w") as fh:
        json.dump({"forward_train_loss": fwd_hist, "inverse_train_loss": inv_hist}, fh)
    with open(cv_fold_path(k, "metrics.json"), "w") as fh:
        json.dump({**row, "config": CV_FINGERPRINT}, fh, indent=2)
    print(f"  fold {k + 1} done in {row['minutes']:.1f} min | fwd alpha RMSE {row['fwd_alpha_RMSE']:.4e} | "
          f"exact-curve RMSE {row['recon_exact_RMSE']:.4e} | E RMSE {row['inv_E_kJ_mol_RMSE']:.3f} kJ/mol")
    del fwd, inv, basis_tr, basis_te, T_bn_tr, T_tn_tr, T_al_tr, T_bn_te, T_tn_te, T_al_te
    if torch.cuda.is_available():
        torch.cuda.empty_cache()
    return row


def cv_reference_row(res, tr_mean, tr_std):
    """Score the existing final model's 10 % grouped test set (notebook `results['Test']`, a <=10,000-curve
    subsample) with the same metrics, for a like-for-like row in the table. Curve level only."""
    r = res["Test"]
    n = len(r["alpha_true"])
    t_phys = np.asarray(r["trunk_norm"]) * np.asarray(tr_std) + np.asarray(tr_mean)
    pm = cv_param_metrics(r["branch_true_phys"], r["branch_pred_phys"], None)
    acc_rf, acc_re = _CvAcc(), _CvAcc()
    acc_rf.add(r["alpha_pred"], r["alpha_true"])
    with torch.no_grad():
        for i in range(0, n, CV_INV_BATCH):
            sl = slice(i, i + CV_INV_BATCH)
            bp = torch.as_tensor(np.asarray(r["branch_pred_phys"][sl]), dtype=torch.float32, device=device)
            tp = torch.as_tensor(t_phys[sl], dtype=torch.float32, device=device)
            acc_re.add(cv_daem_alpha(bp, tp), r["alpha_true"][sl])
    return {"fold": "final model (90/10 test subsample, best epoch)", "n_test_curves": n,
            "recon_fwd_RMSE": acc_rf.rmse(), "recon_exact_RMSE": acc_re.rmse(),
            **{f"inv_{key}": v for key, v in pm.items()}}


