# ---------------------- PURE NUMPY HELPERS (unit-tested) ----------------------
def cv_make_group_ids(branch):
    """One id per unique 9-parameter vector, exactly as the notebook's grouped inverse split does."""
    branch = np.ascontiguousarray(branch)
    keys = branch.view(np.dtype((np.void, branch.dtype.itemsize * branch.shape[1]))).reshape(-1)
    unique_keys, group_ids = np.unique(keys, return_inverse=True)
    return len(unique_keys), np.asarray(group_ids).reshape(-1)


def cv_assign_folds(n_groups, n_folds, seed):
    """Random, balanced assignment of parameter sets (groups) to folds."""
    if n_groups < n_folds:
        raise ValueError(f"Only {n_groups} parameter sets for {n_folds} folds.")
    perm = np.random.default_rng(seed).permutation(n_groups)
    fold_of_group = np.empty(n_groups, dtype=np.int64)
    fold_of_group[perm] = np.arange(n_groups) % n_folds
    return fold_of_group


def cv_beta_index(trunk_norm):
    """Representative curve index per unique beta and a beta id per curve (as in the notebook), with a
    check that curves sharing a beta really share the same trunk grid."""
    ub, first, inv = np.unique(trunk_norm[:, 0, 1], return_index=True, return_inverse=True)
    inv = np.asarray(inv).reshape(-1)
    chk = np.random.default_rng(0).choice(len(trunk_norm), size=min(2000, len(trunk_norm)), replace=False)
    if not np.allclose(trunk_norm[chk], trunk_norm[first[inv[chk]]], atol=1e-6):
        raise ValueError("Curves with the same beta do not share the same trunk grid; unique-beta basis is invalid.")
    return first, inv.astype(np.int64)


class _CvAcc:
    """Streaming SSE / SAE / R2 for arrays (numpy or torch)."""
    def __init__(self):
        self.sse = self.sae = self.sy = self.syy = 0.0
        self.n = 0

    @staticmethod
    def _np(x):
        if hasattr(x, "detach"):
            x = x.detach().cpu().numpy()
        return np.asarray(x, dtype=np.float64)

    def add(self, pred, true):
        p, t = self._np(pred), self._np(true)
        d = p - t
        self.sse += float(np.sum(d * d)); self.sae += float(np.sum(np.abs(d)))
        self.sy += float(np.sum(t)); self.syy += float(np.sum(t * t)); self.n += d.size

    def rmse(self): return float(np.sqrt(self.sse / self.n))
    def mae(self): return float(self.sae / self.n)
    def r2(self):
        sst = self.syy - self.sy ** 2 / self.n
        return float(1.0 - self.sse / sst) if sst > 0 else float("nan")


def cv_param_metrics(true_phys, pred_phys, group_ids=None):
    """Parameter errors in PHYSICAL units (logA, E in kJ/mol, c, and ln k at T_ref).
    Curve level (one prediction per curve) and, if group_ids is given, set level (predictions averaged over
    the heating rates of one parameter set, which mirrors how the real-data pipeline averages the CNN)."""
    tp, pp = np.asarray(true_phys, np.float64), np.asarray(pred_phys, np.float64)
    slots = {"logA": [0, 3, 6], "E_kJ_mol": [1, 4, 7], "c": [2, 5, 8]}

    def block(t, p, prefix):
        e = p - t
        out = {}
        for name, idx in slots.items():
            out[f"{prefix}{name}_RMSE"] = float(np.sqrt(np.mean(e[:, idx] ** 2)))
            out[f"{prefix}{name}_MAE"] = float(np.mean(np.abs(e[:, idx])))
        dlnk = np.log(10.0) * e[:, slots["logA"]] - e[:, slots["E_kJ_mol"]] * 1000.0 / (CV_R_GAS * CV_T_REF_K)
        out[f"{prefix}lnk_Tref_RMSE"] = float(np.sqrt(np.mean(dlnk ** 2)))
        return out

    out = block(tp, pp, "")
    if group_ids is not None:
        g, inv = np.unique(group_ids, return_inverse=True)
        inv = np.asarray(inv).reshape(-1)
        cnt = np.bincount(inv)[:, None].astype(np.float64)
        pm = np.zeros((len(g), 9)); tm = np.zeros((len(g), 9))
        np.add.at(pm, inv, pp); np.add.at(tm, inv, tp)
        out.update(block(tm / cnt, pm / cnt, "setavg_"))
    return out


def cv_summarize(rows):
    """Per-fold table plus mean and SD (ddof=1) rows."""
    df = pd.DataFrame(rows).sort_values("fold").reset_index(drop=True)
    num = df.select_dtypes(include=[np.number]).drop(columns=["fold"], errors="ignore")
    mean_row = {"fold": "mean", **num.mean().to_dict()}
    sd_row = {"fold": "SD", **(num.std(ddof=1) if len(df) > 1 else num.std(ddof=0)).to_dict()}
    return df, pd.concat([df.astype({"fold": object}), pd.DataFrame([mean_row, sd_row])], ignore_index=True)


def cv_validate_dataset(branch, trunk, alpha, path=""):
    """Fail loudly if the file is not the canonical PHYSICAL forward dataset (e.g. the old processed / z-scored one)."""
    p = []
    if branch.ndim != 2 or branch.shape[1] != 9: p.append(f"branch shape {branch.shape}, expected (N, 9)")
    if trunk.ndim != 3 or trunk.shape[2] != 2: p.append(f"trunk shape {trunk.shape}, expected (N, T, 2)")
    if alpha.ndim != 2: p.append(f"alpha shape {alpha.shape}, expected (N, T)")
    if p:
        raise ValueError(f"{path}: " + "; ".join(p))
    if not (len(branch) == len(trunk) == len(alpha)) or alpha.shape != trunk.shape[:2]:
        raise ValueError(f"{path}: inconsistent shapes branch {branch.shape}, trunk {trunk.shape}, alpha {alpha.shape}")
    if not (np.isfinite(branch).all() and np.isfinite(trunk).all() and np.isfinite(alpha).all()):
        p.append("contains NaN/Inf")
    logA, E, c = branch[:, [0, 3, 6]], branch[:, [1, 4, 7]], branch[:, [2, 5, 8]]
    if logA.min() < 9.5 or logA.max() > 17.5: p.append(f"logA range [{logA.min():.3g}, {logA.max():.3g}] is not ~[10, 17]")
    if E.min() < 150 or E.max() > 400: p.append(f"E range [{E.min():.3g}, {E.max():.3g}] is not ~[180, 380] kJ/mol")
    if c.min() < -1e-6 or c.max() > 1 + 1e-6 or np.abs(c.sum(1) - 1).max() > 1e-3: p.append("c is not a probability vector (sum != 1)")
    if alpha.min() < -1e-3 or alpha.max() > 1 + 1e-3: p.append(f"alpha range [{alpha.min():.3g}, {alpha.max():.3g}] is not within [0, 1]")
    if trunk[:, :, 1].min() <= 0 or trunk[:, :, 1].max() > 200: p.append("beta (trunk[:, :, 1]) is not a physical heating rate")
    if trunk[:, :, 0].min() < -1e-6: p.append("time (trunk[:, :, 0]) is negative")
    if np.all(np.abs(branch.mean(0)) < 0.2) and np.all(np.abs(branch.std(0) - 1.0) < 0.2):
        p.append("branch looks z-scored (mean ~0, SD ~1) rather than physical")
    if p:
        raise ValueError(f"{path} is not the canonical physical dataset: " + "; ".join(p) +
                         ". Point DATA_PATH at forward_dataset_canonical.npz.")


