    p_cnn = cnn_initial_guess(base_curves)

    # A) Multi-start on original measured curves: CNN start plus random parameter starts.
    starts = [("CNN", p_cnn)] + [(f"random_{i+1}", random_start(rng)) for i in range(N_RANDOM_STARTS)]
