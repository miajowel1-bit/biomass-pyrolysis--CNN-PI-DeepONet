    append_row(multi_summary_path, multi_summary)
    
    mc_rows_material = []
    for draw in range(N_MC_DRAWS):
        draw_rng = np.random.default_rng(BASE_SEED + 10000 + draw)
        # Sample one published mass-SD level in mg and perturb the absolute-mass
        # column selected by COLUMN_WEIGHT. Conversion is then recomputed from it.
        perturbed = []
        draw_sigmas = {}
        draw_temp_shifts = {}
        for beta, path in fmap.items():
            df = clean_tga_excel(path)
            temp = df["Temperature"].to_numpy(dtype=np.float64)
            weight = df["Weight"].to_numpy(dtype=np.float64)
            keep = (temp >= TEMP_WINDOW[0]) & (temp <= TEMP_WINDOW[1])
            weight = weight[keep]
            temp = temp[keep]
            temp_shift_c = float(draw_rng.uniform(-TEMP_SHIFT_BOUND_C, TEMP_SHIFT_BOUND_C))
            draw_temp_shifts[float(beta)] = temp_shift_c
            sigma_mg = float(draw_rng.uniform(*MASS_NOISE_SD_RANGE_MG))
            sigma_pct_points = mass_noise_sd_wt_percent(sigma_mg)
            draw_sigmas[float(beta)] = sigma_mg  # saved with mg units in result_row
            noisy_weight = weight + draw_rng.normal(0.0, sigma_pct_points, size=weight.shape)
            
            alpha = np.clip((noisy_weight[0] - noisy_weight) / (noisy_weight[0] - noisy_weight[-1]), 0.0, 1.0)
            window_mass_loss = abs(noisy_weight[0] - noisy_weight[-1])
            if sigma_pct_points / max(window_mass_loss, 1e-12) <= 0.003:
                alpha = np.maximum.accumulate(alpha)
            
            t_exp = (temp + temp_shift_c) / float(beta); order = np.argsort(t_exp); t_exp, alpha = t_exp[order], alpha[order]
            t_unique, idx = np.unique(t_exp, return_index=True); alpha_unique = alpha[idx]
            alpha_grid = np.interp(np.asarray(t_grid), t_unique, alpha_unique,
