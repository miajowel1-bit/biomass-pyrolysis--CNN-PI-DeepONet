def clean_tga_excel(path):
    """Load the notebook's TGA Excel layout and discard its units row."""
    df = pd.read_excel(path)
    df.columns = [str(c).strip() for c in df.columns]
    missing = [c for c in (COLUMN_TEMP, COLUMN_WEIGHT) if c not in df.columns]
    if missing:
        raise ValueError(f"{path}: missing columns {missing}; found {list(df.columns)}")
    for col in (COLUMN_TEMP, COLUMN_WEIGHT):
        df[col] = pd.to_numeric(
            df[col].astype(str).str.replace(",", "", regex=False).str.strip(),
            errors="coerce"
        )
    return (df.dropna(subset=[COLUMN_TEMP, COLUMN_WEIGHT])
              .sort_values(COLUMN_TEMP).reset_index(drop=True))

