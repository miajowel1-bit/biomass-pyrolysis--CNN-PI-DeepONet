                              "trunk_norm": ((trunk_phys-trunk_mean)/trunk_std).astype(np.float32),
                               "sigma_mass": sigma_pct_points})
        p0 = cnn_initial_guess(perturbed)
        p, fit_mse, exp_rmse, per_curve = fit_from_start(perturbed, p0, MC_STEPS)
        row = result_row(material, draw, "CNN_initialized_refinement", p,
